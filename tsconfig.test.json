{
  // Test sources only. Mirrors tsconfig.app.json but adds Node types, because the suites read
  // fixture files from disk. Keeping this separate is what lets the app project stay free of Node
  // globals while tests still get typechecked by `tsc -b`.
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    // DOM is needed even here: the modules under test include signature.ts, which references
    // Image and document.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": ["node", "vite/client"]
  },
  // Ambient declarations are needed here too. Tests pull in the modules they exercise, so a suite
  // touching the GIF encoder needs the hand-written `gifenc` types from src/types — that package
  // ships no declarations of its own. Without this the app project compiles and the test project
  // does not, which vitest would never reveal because it transpiles rather than typechecks.
  "include": ["src/**/*.test.ts", "src/types/*.d.ts"]
}
